{
  "name": "portfolio-manager",
  "version": "2.0.0",
  "description": "Portfolio Manager — Tauri + React desktop app",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite frontend",
    "build": "npm run typecheck && vite build frontend",
    "preview": "vite preview --outDir frontend/dist",
    "test": "vitest run --root frontend",
    "test:watch": "vitest --root frontend",
    "test:coverage": "vitest run --root frontend --coverage",
    "typecheck": "tsc --noEmit -p frontend/tsconfig.json",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.51.0",
    "@tauri-apps/api": "^2.0.0",
    "dompurify": "^3.1.6",
    "mermaid": "^11.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/jest-dom": "^6.4.6",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/dompurify": "^3.0.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^2.0.0",
    "jsdom": "^24.1.0",
    "typescript": "^5.5.3",
    "vite": "^5.3.4",
    "vitest": "^2.0.0"
  }
}
